<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>WemDecoder</RootNamespace>
    <NoWarn>$(NoWarn);CA1512;CA1822;CA1852;CA1859;CA2208</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.bin" LogicalName="WemDecoder.Resources.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
